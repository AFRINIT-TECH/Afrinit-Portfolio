# Server Configuration
APP_PORT=3000
PUBLIC_URL=http://localhost:3000
UPLOAD_DIR=./uploads

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=afrinit_portfolio
DB_SSLMODE=disable

# Optional: Direct PostgreSQL Connection String (Overrides individual DB_* settings if provided)
# DATABASE_URL=postgres://postgres:your_secure_password@localhost:5432/afrinit_portfolio?sslmode=disable

# Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=15m
DB_CONN_MAX_IDLE_TIME=5m
